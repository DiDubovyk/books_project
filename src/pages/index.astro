---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import NavBar from "../components/NavBar.astro";

const books = await getCollection("books");
const goodreads = await getCollection("goodreads");

export const prerender = true;

const readBooks = goodreads
  .filter((b) => b.data.My_Rating > 0)
  .filter((b) => b.data.ISBN13.replace(/[^0-9]/g, "").length > 0);

function getCover(isbn13: string) {
  const clean = isbn13.replace(/[^0-9]/g, "");
  if (!clean) return "/images/bookshelf.jpg";
  return `https://covers.openlibrary.org/b/isbn/${clean}-M.jpg`;
}
---

<Layout title="My book shelf">
  <header>
    <NavBar />
    <div class="header">
      <div class="header__title">
        <!-- <span class="header-title__ornament">✦</span> -->
        <blockquote>
          <h1 class="heading-primary">
            "Books are a uniquely portable <span>magic</span>."
          </h1>
          <cite>Stephen King</cite>
        </blockquote>
        <div class="header__btn">
          <button class="header__btn--primary"
            >Explore smth new <span>&rarr;</span></button
          >
        </div>
      </div>
    </div>
  </header>
  <main>
    <section aria-label="My book recommendations">
      <div class="books-container">
        <h2 class="heading-secundary">Recommendations Selection</h2>
        <div class="books-container__list">
          {
            readBooks.map((book) => {
              const { Title, Author, My_Rating, ISBN13 } = book.data;
              const cover = getCover(ISBN13);

              return (
                <article class="book-card">
                  <a class="book-card__cover" href={`/book/${book.id}`}>
                    <img
                      src={cover}
                      alt={Title}
                      onerror="this.onerror=null; this.src='/images/bookshelf.jpg'"
                      onload="if(this.naturalWidth <= 1) this.src='/images/bookshelf.jpg'"
                    />
                  </a>

                  <div class="book-card__content">
                    <div class="book-card__content-title">
                      <h3 class="heading-tertiary">{Title} </h3>
                      <h4 class="heading-four">{Author}</h4>
                    </div>

                    <span class="book-card__stars">
                      {Array.from({ length: My_Rating }).map((_, i) => (
                        <span>★</span>
                      ))}
                    </span>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
    <section aria-label="selected" class="selected">
      <div class="selected__content">
        <h2 class="heading-secundary">Featured Book of the Week</h2>
        <h3 class="selected__content--title">Name of book</h3>
        <p class="selected__content--description">
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Perspiciatis
          delectus necessitatibus illo eius excepturi, nobis sequi recusandae
          architecto iusto facilis eveniet vel magni natus voluptas consequuntur
          voluptates nihil iste fugiat!
        </p>
        <div class="selected__indicators"></div>
        <button class="selected__btn">Discover More</button>
      </div>
      <div class="selected__image">
        <img
          class="selected__image--cover"
          src="/images/unnamed.png"
          alt="book cover"
        />
      </div>
    </section>
  </main>
</Layout>
